{
  "name": "transformer-visual-academy",
  "private": true,
  "version": "1.0.0",
  "description": "经典 Transformer 中文交互式学习网站",
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "dev": "node scripts/dev.mjs",
    "build": "npm run compile && node scripts/build.mjs",
    "preview": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/*.test.cjs",
    "build:vite": "npm run compile && vite build"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
